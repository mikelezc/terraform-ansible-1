# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git — it contains secrets

# Your public IP for SSH access (find it with: curl ifconfig.me)
my_ip = "YOUR_PUBLIC_IP/32"

# Name of the AWS key pair in eu-west-3 (must already exist in AWS)
key_name = "cloud-1-key"

# Local path to the private key file for Ansible SSH
ssh_private_key_path = "~/.ssh/cloud-1-key.pem"

# Database credentials — change these!
db_password      = "choose_a_strong_password"
db_root_password = "choose_a_strong_root_password"

# WordPress admin account (auto-installed on first boot via WP-CLI)
wp_admin_password = "choose_a_strong_wp_password"
# wp_admin_user  = "admin"           # default: admin
# wp_admin_email = "admin@example.com"
# wp_title       = "Cloud-1"

# Optional: email for CloudWatch alarm notifications (leave empty to disable)
# After terraform apply, check your inbox and confirm the SNS subscription link.
# alert_email = "tu-email@ejemplo.com"

# Optional: DuckDNS (leave empty to skip DNS update)
# duckdns_token     = "your-duckdns-token"
# duckdns_subdomain = "your-duckdns-subdomain"

# Optional overrides (defaults are fine for evaluation)
# aws_region    = "eu-west-3"
# instance_type = "t3.micro"
# web_desired   = 2
# web_min_size  = 2
# web_max_size  = 4
