# Terraform secrets and state — NEVER commit these
terraform/terraform.tfvars
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.d
terraform/*.tfplan
terraform/.terraform.tfstate.lock.info
# Root-level state (if terraform was accidentally run outside terraform/)
terraform.tfstate
terraform.tfstate.backup

# Ansible secrets
ansible/roles/database/files/.env.db.local
*.pem
*.key

# Auto-generated files (recreated by terraform apply)
ansible/inventory.ini

# OS
.DS_Store
 